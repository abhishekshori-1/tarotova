# Tarotova — local environment template. Copy to .env.local and fill in.
# No external accounts exist yet (see PLAN.md section 13); the values below
# are the local-dev stand-ins actually wired up in this build. Swapping in
# real Supabase/Resend/Turnstile credentials later requires code changes
# noted in README.md, not just new env values.

# --- Port series (kept consistent across every local service; see README) ---
# 47100 = web app (next dev / next start), 47101 = drizzle-kit studio.
PORT=47100

# --- Local SQLite stand-in for Supabase Postgres (section 5/7) ---
# Filename only — the app always stores it under ./data/ (kept out of git).
DATABASE_FILE=tarotova.db

# --- OTP HMAC key (section 6). Generate with: openssl rand -hex 32 ---
OTP_HMAC_SECRET=dev-only-insecure-secret-change-me
OTP_HMAC_KEY_VERSION=1

# --- Session cookie signing/hash (section 6) ---
SESSION_HASH_SECRET=dev-only-insecure-secret-change-me

# --- Email delivery (section 5/8) ---
# "console" logs the code to the server terminal and, in non-production
# builds only, echoes it back in the /otp response so the flow is testable
# without a real inbox. Set to "resend" and provide RESEND_API_KEY once a
# verified sending domain exists.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Tarotova <onboarding@tarotova.example>"

# --- Bot protection (section 5/6) ---
# Left blank in local dev: Turnstile validation is skipped with a logged
# warning when no secret is configured. Do not deploy publicly in that state.
TURNSTILE_SECRET_KEY=
