# Tarotova — local environment template. Copy to .env.local and fill in.
# These defaults are for local development. Live infrastructure is described
# in docs/INFRA.md; never copy development credentials into production.

# --- Port series (kept consistent across every local service; see README) ---
# 47100 = web app (next dev / next start), 47101 = drizzle-kit studio.
PORT=47100

# --- Database (section 5/7) ---
# Unset (the default): the app runs on embedded pglite (WASM Postgres, no
# account needed) — file-backed under ./data/pglite for dev, in-memory for
# tests. Set this to a real Postgres connection string (e.g. Supabase's
# pooled/transaction-mode URI) to use real Postgres instead — same schema,
# same migrations, no code changes needed.
DATABASE_URL=

# --- OTP HMAC key (section 6). Generate with: openssl rand -hex 32 ---
OTP_HMAC_SECRET=dev-only-insecure-secret-change-me
OTP_HMAC_KEY_VERSION=1

# --- Session cookie signing/hash (section 6) ---
SESSION_HASH_SECRET=dev-only-insecure-secret-change-me

# --- Email delivery (section 5/8) ---
# "console" logs the code to the server terminal and, in non-production
# builds only, echoes it back in the /otp response so the flow is testable
# without a real inbox. Production requires "resend", RESEND_API_KEY and
# EMAIL_FROM using the verified sending domain; it never falls back to console.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Tarotova <do-not-reply@mail.tarotova.com>"

# --- Retention job ---
# /api/internal/cleanup deletes expired drafts, readings, challenges and
# sessions. Vercel Cron (vercel.json, daily) sends `Authorization: Bearer
# $CRON_SECRET` automatically once this is set; unset, the route refuses
# every call. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Bot protection (section 5/6) ---
# Both unset (the default): no Turnstile widget renders on the email page,
# and the server skips verification with a logged warning. Set both once
# you have a Cloudflare Turnstile widget (site key is public by design —
# NEXT_PUBLIC_* is exposed to the browser; the secret key never is).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contextual answer (v2 Release B; docs/REVIEW-V2.md findings 1, 2, 8) ---
# GENERATION_ENABLED=false (the default) hides the personalized section
# entirely. GUEST_GENERATION_ENABLED=false pauses it for email-free readings
# only. GENERATION_PROVIDER is an ordered chain: production defaults to
# "gemini,deepseek" (Gemini first, DeepSeek when Gemini fails); outside
# production it defaults to "stub" (free, offline, deterministic). A listed
# provider with no key is skipped and logged; with none usable the answer is
# reported unavailable — the cards and editorial reading still show. Budgets
# are fixed UTC-day windows; keep a spend cap on each provider's account too.
GENERATION_ENABLED=true
GUEST_GENERATION_ENABLED=true
# Release C1: follow-up turns under a reading (three per reading). Needs GENERATION_ENABLED too.
FOLLOWUPS_ENABLED=true
GENERATION_PROVIDER=stub
# Grounding reviewer, configured on its own: any vendor, in the writer chain
# or not, never assumed. Unset in production = every generated answer is
# withheld after triage (the library reading still shows). Locally, an
# all-stub writer chain implies the stub reviewer. Sonnet-free C configuration:
# GENERATION_PROVIDER=deepseek,gemini; GENERATION_CLASSIFIER_PROVIDER=gemini;
# GENERATION_REVIEW_PROVIDER=gemini; GENERATION_REVIEW_MODEL=gemini-3.8-flash;
# GENERATION_REPAIR_PROVIDER=deepseek; GEMINI_REVIEW_THINKING_LEVEL=low.
# No review fallback.
# See docs/RELEASE-C-COST.md for calibration and release status.
GENERATION_REVIEW_PROVIDER=
# Defaults to that provider's answer model.
GENERATION_REVIEW_MODEL=
# Optional Gemini reviewer effort: low, medium or high. Unset uses the model
# default; calibrate a different effort before enabling it. Other roles are unchanged.
GEMINI_REVIEW_THINKING_LEVEL=
# Triage by a vendor other than the writer chain's first (e.g. gemini while
# deepseek writes). Unset = the chain's first provider. No fallback.
GENERATION_CLASSIFIER_PROVIDER=
# Repairs by a vendor other than the writer chain (e.g. gemini repairing
# deepseek drafts). Unset = the writer chain. Replaces the repair call only.
GENERATION_REPAIR_PROVIDER=
# Optional Anthropic adapter only; unused by the Sonnet-free configuration.
# Caches system prompts and the frozen reading block on follow-up reviews.
# One cache hit after a 5m write pays back the write premium. At low traffic
# isolated cold writes cost 25% more for the cached prefix; leave blank to
# disable. 1h writes cost 2x and need two hits to pay back. Measure actual
# cache counters; hourly traffic alone does not determine reuse.
ANTHROPIC_PROMPT_CACHE=
# Gemini (preferred). Models default to gemini-3.8-flash (answer) and gemini-3.8-flash (classifier).
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_CLASSIFIER_MODEL=
# DeepSeek (optional, any role). Model id "deepseek-flash" is DeepSeek V4.1 Flash; "deepseek-v4-pro" also exists.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_CLASSIFIER_MODEL=
# Anthropic (explicit opt-in only; not a default fallback). Models default to claude-sonnet-5 and claude-haiku-4-5-20251001.
ANTHROPIC_API_KEY=
# Only for an organization-level key (the API then requires the workspace to
# bill, "wrkspc_..." from Console → Workspaces). A workspace-scoped key needs nothing here.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=
ANTHROPIC_CLASSIFIER_MODEL=
# Per provider call; two attempts through the chain must fit the route's 60 s.
GENERATION_TIMEOUT_MS=30000
GENERATION_LIMIT_SESSION_DAY=10
GENERATION_LIMIT_IP_DAY=30
GENERATION_LIMIT_GLOBAL_DAY=400
