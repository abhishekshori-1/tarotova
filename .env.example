# Tarotova — local environment template. Copy to .env.local and fill in.
# No external accounts exist yet by default; the values below document what
# actually gets wired up once you have them. See docs/IMPLEMENTATION.md.

# --- Port series (kept consistent across every local service; see README) ---
# 47100 = web app (next dev / next start), 47101 = drizzle-kit studio.
PORT=47100

# --- Database (section 5/7) ---
# Unset (the default): the app runs on embedded pglite (WASM Postgres, no
# account needed) — file-backed under ./data/pglite for dev, in-memory for
# tests. Set this to a real Postgres connection string (e.g. Supabase's
# pooled/transaction-mode URI) to use real Postgres instead — same schema,
# same migrations, no code changes needed.
DATABASE_URL=

# --- OTP HMAC key (section 6). Generate with: openssl rand -hex 32 ---
OTP_HMAC_SECRET=dev-only-insecure-secret-change-me
OTP_HMAC_KEY_VERSION=1

# --- Session cookie signing/hash (section 6) ---
SESSION_HASH_SECRET=dev-only-insecure-secret-change-me

# --- Email delivery (section 5/8) ---
# "console" logs the code to the server terminal and, in non-production
# builds only, echoes it back in the /otp response so the flow is testable
# without a real inbox. Set to "resend" and provide RESEND_API_KEY once a
# verified sending domain exists.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Tarotova <onboarding@tarotova.example>"

# --- Bot protection (section 5/6) ---
# Both unset (the default): no Turnstile widget renders on the email page,
# and the server skips verification with a logged warning. Set both once
# you have a Cloudflare Turnstile widget (site key is public by design —
# NEXT_PUBLIC_* is exposed to the browser; the secret key never is).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
